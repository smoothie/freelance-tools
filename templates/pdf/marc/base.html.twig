{% trans_default_domain 'tools' %}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>
        @font-face {
            font-family: "Poppins";
            src: url(/Poppins/Poppins-SemiBold.ttf) format("truetype");
            font-weight: 600;
        }
        @font-face {
            font-family: "Poppins";
            src: url(/Poppins/Poppins-Black.ttf) format("truetype");
            font-weight: 900;
        }
        @font-face {
            font-family: "Mulish";
            src: url(/Mulish/Mulish-Regular.ttf) format("truetype");
            font-weight: 400;
        }
        @font-face {
            font-family: "Mulish";
            src: url(/Mulish/Mulish-SemiBold.ttf) format("truetype");
            font-weight: 600;
        }
        @page {
            size: A4;
            margin: 45mm 20mm 32mm 25mm;
        }
        body {
            margin: 0;
            color: #212121;
            font-family: "Mulish", sans-serif;
            font-size: 11pt;
            line-height: 1.2;
        }
        h1, h2, p, address { margin: 0; }
        h1, h2 {
            font-family: "Poppins", sans-serif;
            font-weight: 600;
        }
        h1 { font-size: 22pt; margin-bottom: 6mm; }
        h2 { font-size: 12.5pt; margin: 6mm 0 3mm; }
        p { margin-bottom: 3mm; }
        address { font-style: normal; }
        a { color: #212121; text-decoration: none; }
        .pageHeader {
            position: fixed;
            top: -31mm;
            left: 0;
            right: 0;
            border-top: 1mm solid #FFCC33;
            padding-top: 3mm;
        }
        .senderName {
            font-family: "Poppins", sans-serif;
            font-weight: 900;
            font-size: 22pt;
            white-space: nowrap;
        }
        .headerContact { font-size: 8pt; margin-top: 1mm; }
        .pageMeta { position: relative; height: 50mm; }
        .returnAddress { width: 80mm; font-size: 8pt; }
        .recipient { position: absolute; top: 17.7mm; left: 0; width: 80mm; line-height: 0.8; }
        .recipient span { display: block; }
        .infobox { position: absolute; top: 0; left: 100mm; width: 65mm; }
        .infobox table { width: 100%; font-size: 9pt; }
        .infobox th { width: 53%; font-weight: 600; text-align: left; }
        .infobox td { text-align: right; }
        .infobox th, .infobox td { padding: 0 0 1.5mm; vertical-align: top; }
        .foldMark { position: fixed; left: -25mm; width: 5mm; border-top: 0.25mm solid #212121; }
        .foldMark.first { top: 60mm; }
        .foldMark.middle { top: 103.5mm; width: 7.5mm; }
        .foldMark.last { top: 165mm; }
        .pageFooter {
            position: fixed;
            bottom: -25mm;
            left: 0;
            right: 0;
            border-top: 0.25mm solid #D9D9D9;
            padding-top: 2mm;
            font-size: 8pt;
        }
        .pageFooter table { width: 100%; table-layout: fixed; }
        .pageFooter td { vertical-align: top; width: 33.33%; }
        .pageFooter p { margin: 0; }
        .pageNumber { text-align: right; margin-top: 2mm; }
        .pagenum:before { content: counter(page); }
        table { border-collapse: collapse; border-spacing: 0; }
        .positions { width: 100%; table-layout: fixed; margin-top: 5mm; }
        .positions thead { display: table-header-group; }
        .positions tr, .payments tr { page-break-inside: avoid; }
        .positions th, .positions td {
            padding: 2.5mm 1mm;
            border-bottom: 0.25mm solid #D9D9D9;
            vertical-align: top;
            font-size: 9pt;
            text-align: left;
            overflow-wrap: break-word;
        }
        .positions th { font-weight: 600; }
        .positions .position { width: 6%; }
        .positions .description { width: 40%; }
        .positions .quantity { width: 16%; }
        .positions .money { width: 19%; text-align: right; }
        .totals { width: 100%; margin-top: 5mm; page-break-inside: avoid; }
        .totals td { padding: 2mm 1mm; text-align: right; }
        .totals td:first-child { width: 75%; }
        .totals .total td { border-top: 0.5mm solid #FFCC33; font-weight: 600; }
        .payments { width: 100%; font-size: 9pt; }
        .payments th, .payments td { padding: 2mm 1mm; text-align: right; border-bottom: 0.25mm solid #D9D9D9; }
        .payments th:first-child, .payments td:first-child { text-align: left; width: 46%; }
        .payments th { font-weight: 600; }
        .paymentTerms { margin-top: 6mm; page-break-inside: avoid; }
        .notes { margin-top: 5mm; }
    </style>
</head>
<body>
<header class="pageHeader">
    <p class="senderName">{{ sender.name }}</p>
    <p class="headerContact">{{ sender.contactInformation.mail }} · {{ sender.contactInformation.web }}</p>
</header>
<div class="foldMark first"></div>
<div class="foldMark middle"></div>
<div class="foldMark last"></div>
<footer class="pageFooter">
    <table>
        <tr>
            <td>
                <p>{{ sender.name }}</p>
                <p>{{ sender.street }}</p>
                <p>{{ sender.location }}</p>
                {% if sender.vatId is not empty %}<p>USt-IdNr.: {{ sender.vatId }}</p>{% endif %}
            </td>
            <td>
                <p>Tel: {{ sender.contactInformation.phone | to_pretty_phone_number }}</p>
                <p>{{ sender.contactInformation.mail }}</p>
                <p>{{ sender.contactInformation.web }}</p>
            </td>
            <td>
                <p>{{ sender.paymentInformation.bank }}</p>
                <p>IBAN: {{ sender.paymentInformation.iban }}</p>
                <p>BIC: {{ sender.paymentInformation.bic }}</p>
            </td>
        </tr>
    </table>
    <div class="pageNumber">Seite <span class="pagenum"></span>{% if lastPageNumber | default(null) %} von {{ lastPageNumber }}{% endif %}</div>
</footer>
<section class="pageMeta">
    <address class="returnAddress">{{ sender.name }} · {{ sender.street }} · {{ sender.location }}</address>
    <address class="recipient">
        <span>{{ recipient.name }}</span>
        <span>{{ recipient.street }}</span>
        <span>{{ recipient.location }}</span>
        {% if recipient.country is not empty %}<span>{{ recipient.country | country }}</span>{% endif %}
        {% if recipient.vatId is not empty %}<span>USt-IdNr.: {{ recipient.vatId }}</span>{% endif %}
    </address>
    <div class="infobox">{% block infobox %}{% endblock %}</div>
</section>
<main>{% block content %}{% endblock %}</main>
</body>
</html>
